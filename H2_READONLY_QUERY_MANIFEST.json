      ],
      "purpose": "identity",
      "sql": "SELECT pg_catalog.current_database() AS db, current_user AS actor, session_user AS login, pg_catalog.current_setting('transaction_read_only') AS ro, pg_catalog.current_setting('transaction_isolation') AS isolation, pg_catalog.current_setting('statement_timeout') AS statement_timeout, pg_catalog.current_setting('lock_timeout') AS lock_timeout, pg_catalog.current_setting('search_path') AS search_path LIMIT 1;",
