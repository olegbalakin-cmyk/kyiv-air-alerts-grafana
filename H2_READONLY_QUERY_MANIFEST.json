    {
      "id": "Q03",
      "contracts": [
        "I2",
        "READ-03",
        "206"
      ],
      "purpose": "schema/db writable authority",
      "sql": "SELECT pg_catalog.has_schema_privilege(current_user,'public','CREATE') AS schema_create, pg_catalog.has_database_privilege(current_user,pg_catalog.current_database(),'CREATE') AS database_create, pg_catalog.has_database_privilege(current_user,pg_catalog.current_database(),'TEMP') AS temp_create LIMIT 1;",
      "max_rows": 1,
      "max_bytes": 1024,
      "sql_sha256": "58d8f4467dc84958661daafde205e6b556c365515a460af352436c7db63d8f23",
      "expected_columns": [
        "schema_create",
        "database_create",
        "temp_create"
      ]
    },
    {
      "id": "Q04",
      "contracts": [
        "I2",
        "READ-03",
        "196",
        "206"
      ],
      "purpose": "aggregate table write capability",
      "sql": "SELECT count(*) AS relation_count, count(*) FILTER (WHERE pg_catalog.has_table_privilege(c.oid,'INSERT') OR pg_catalog.has_table_privilege(c.oid,'UPDATE') OR pg_catalog.has_table_privilege(c.oid,'DELETE') OR pg_catalog.has_table_privilege(c.oid,'TRUNCATE') OR pg_catalog.has_table_privilege(c.oid,'TRIGGER') OR pg_catalog.has_table_privilege(c.oid,'MAINTAIN')) AS writable_count FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p','m','f') LIMIT 1;",
      "max_rows": 1,
      "max_bytes": 1024,
      "sql_sha256": "20396ba45e315b625d8d5f005490e0bc31dedd9dae9c8d1a92f478f9602a29b0",
      "expected_columns": [
        "relation_count",
        "writable_count"
      ]
    },
    {
      "id": "Q05",
      "contracts": [
        "I4",
        "READ-01",
        "ACL-01",
        "206"
      ],
      "purpose": "eight raw relation ACLs with NULL retained",
      "sql": "SELECT c.relname, c.relkind, c.relowner::pg_catalog.regrole::text AS owner_role, (c.relacl IS NULL) AS raw_acl_is_null, c.relacl::text AS raw_acl FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relname IN ('alert_episodes','alert_episode_sources','attack_event_classifications','attack_event_sources','attack_events','ingestion_checkpoints','ingestion_runs','current_ingestion_checkpoints') ORDER BY c.relname LIMIT 9;",
      "max_rows": 9,
      "max_bytes": 8192,
