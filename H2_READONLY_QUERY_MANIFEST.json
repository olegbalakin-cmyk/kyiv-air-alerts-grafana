        "206"
      ],
      "purpose": "inspector role flags",
      "sql": "SELECT rolname, rolcanlogin, rolsuper, rolcreatedb, rolcreaterole, rolreplication, rolbypassrls, rolinherit FROM pg_catalog.pg_roles WHERE rolname='h2_catalog_inspector_ro' LIMIT 2;",
