    {
      "id": "Q02",
      "contracts": [
        "I2",
        "READ-03",
        "206"
      ],
      "purpose": "inspector direct memberships",
      "sql": "SELECT m.rolname AS member_role, p.rolname AS granted_role, a.admin_option, a.inherit_option, a.set_option FROM pg_catalog.pg_auth_members a JOIN pg_catalog.pg_roles m ON m.oid=a.member JOIN pg_catalog.pg_roles p ON p.oid=a.roleid WHERE m.rolname='h2_catalog_inspector_ro' LIMIT 2;",
      "max_rows": 2,
