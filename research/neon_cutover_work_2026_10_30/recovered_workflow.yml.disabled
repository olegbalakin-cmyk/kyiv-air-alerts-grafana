name: Neon cutover Work current snapshot and browser proof

on:
  push:
    branches: [research-neon-cutover-work-2026-10-30]
    paths:
      - .github/workflows/neon-cutover-work-replay.yml
      - research/neon_cutover_work_2026_10_30/**

permissions:
  contents: read

concurrency:
  group: neon-cutover-work-current-replay
  cancel-in-progress: false

jobs:
  replay-browser:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
        with:
          path: research
          persist-credentials: false
      - uses: actions/checkout@v4
        with:
          ref: 0ecbb291e8f443f7ab366bc4ac033d096f2c44f4
          path: reference
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.13'
      - name: Install approved parser and browser test dependencies
        run: python -m pip install requests beautifulsoup4 playwright
      - name: Verify and extract immutable SQL readback and original HTTP capture
        run: |
          python research/research/neon_cutover_work_2026_10_30/unpack_inputs.py
      - name: Run existing generators at the current publication cutoff
        run: |
          python research/research/neon_cutover_work_2026_10_30/replay.py \
            --site reference/kyiv-air-alerts-grafana \
            --reference-sha 0ecbb291e8f443f7ab366bc4ac033d096f2c44f4 \
            --accepted-adapter inputs/adapter/C6-22CITY-READER-01 \
            --research research/research \
            --rows inputs/current-physical-rows.json \
            --receipt inputs/current-physical-receipt.json \
            --classifications inputs/class-snapshot.json \
            --cutoff 2026-10-30T15:27:55.138400Z \
            --corroborating-http inputs/http/entity_bytes.bin \
            --http-evidence inputs/http_evidence.json \
            --dst-plan inputs/dst_plan.json \
            --output proof/replay
      - name: Test all city selectors, charts, CSV and local source rollback
        run: |
          python research/research/neon_cutover_work_2026_10_30/browser_smoke.py \
            --site reference/kyiv-air-alerts-grafana \
            --candidate proof/replay --out proof/browser
      - name: Preserve complete evidence on all outcomes
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: neon-cutover-work-${{ github.run_id }}
          path: proof/
          if-no-files-found: error
          retention-days: 30
