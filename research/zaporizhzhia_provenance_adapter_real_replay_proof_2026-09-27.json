merge_mapping(role: str, current: dict, incoming: dict) -> dict:\n+        out = copy.deepcopy(current)\n+        for key, value in incoming.items():\n+            if key not in out:\n+                out[key] = copy.deepcopy(value)\n+                continue\n+            if key in {\"present\", \"validated_by_review\", \"episode_specific\"}:\n+                a = out.get(key)\n+                b = value\n+                if isinstance(a, bool) and isinstance(b, bool) and a != b:\n+                    out[key] = False\n+                    diagnostic[\"conflicts\"].append(\n+                        {\"role\": role, \"field\": key, \"generated\": a, \"persisted\": b, \"resolution\": False}\n+                    )\n+                continue\n+            if key == \"neighboring_alert_check\" and isinstance(out.get(key), dict) and isinstance(value, dict):\n+                nested = copy.deepcopy(out[key])\n+                for nested_key, nested_value in value.items():\n+                    if nested_key not in nested:\n+                        nested[nested_key] = copy.deepcopy(nested_value)\n+                    elif nested_key == \"passed\":\n+                        a = nested.get(nested_key)\n+                        b = nested_value\n+                        if isinstance(a, bool) and isinstance(b, bool) and a != b:\n+                            nested[nested_key] = False\n+                            diagnostic[\"conflicts\"].append(\n+                                {\n+                                    \"role\": role,\n+                                    \"field\": \"neighboring_alert_check.passed\",\n+                                    \"generated\": a,\n+                                    \"persisted\": b,\n+                                    \"resolution\": False,\n+                                }\n+                            )\n+                out[key] = nested\n+        return out\n+\n+    for role in REVIEW_PROVENANCE_ROLES:\n+        if role not in persisted:\n+            continue\n+        incoming = persisted.get(role)\n+        if not isinstance(incoming, (bool, dict)):\n+            diagnostic[\"rejected_roles\"].append({\"role\": role, \"reason\": \"malformed_role_payload\"})\n+            continue\n+        current = merged.get(role)\n+        if current is None:\n+            merged[role] = copy.deepcopy(incoming)\n+            diagnostic[\"accepted_roles\"].append(role)\n+            continue\n+\n+        if isinstance(current, bool) or isinstance(incoming, bool):\n+            current_state = current if isinstance(current, bool) else current.get(\"present\") if isinstance(current, dict) else None\n+            incoming_state = incoming if isinstance(incoming, bool) else incoming.get(\"present\") if isinstance(incoming, dict) else None\n+            if isinstance(current_state, bool) and isinstance(incoming_state, bool) and current_state != incoming_state:\n+                merged[role] = False\n+                diagnostic[\"conflicts\"].append(\n+                    {\"role\": role, \"field\": \"present\", \"generated\": current_state, \"persisted\": incoming_state, \"resolution\": False}\n+                )\n+            elif isinstance(current, dict) and isinstance(incoming, dict):\n+                merged[role] = merge_mapping(role, current, incoming)\n+            elif isinstance(incoming_state, bool):\n+                merged[role] = copy.deepcopy(incoming)\n+            diagnostic[\"accepted_roles\"].append(role)\n+            continue\n+\n+        if isinstance(current, dict) and isinstance(incoming, dict):\n+            merged[role] = merge_mapping(role, current, incoming)\n+            diagnostic[\"accepted_roles\"].append(role)\n+        else:\n+            diagnostic[\"rejected_roles\"].append({\"role\": role, \"reason\": \"incompatible_generated_role_payload\"})\n+\n+    return merged, diagnostic\n+\n+\n def candidate_from_history(city: str, row: dict, bucket: str, target_id: str, 