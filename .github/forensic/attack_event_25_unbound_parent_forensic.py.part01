    # Reproduce the exact accepted STEP 2B parent-corpus fingerprint logic.
    all_cities = sorted({str(r.get("city_key")) for r in records if isinstance(r, dict) and r.get("city_key")})
    if len(all_cities) != 23:
        fail("AUDIT_CITY_SET_MISMATCH", affected_count=EXPECTED_TARGETS)
    parent_rows_raw = select(
        "SELECT episode_uid::text, city_key::text, alert_type::text, episode_state::text, "
        "canonicalization_version::text, start_at, end_at "
        "FROM public.alert_episodes "
        "WHERE city_key = ANY(%s) "
        "ORDER BY city_key, start_at, end_at, episode_uid",
        (all_cities,),
    )
    canonical_parent_rows = []
    for uid, city, alert_type, state, canon, start_at, end_at in parent_rows_raw:
        start_utc = start_at.astimezone(timezone.utc) if start_at is not None else None
        end_utc = end_at.astimezone(timezone.utc) if end_at is not None else None
        canonical_parent_rows.append([
            str(uid),
            str(city),
            str(alert_type) if alert_type is not None else None,
            str(state) if state is not None else None,
            str(canon) if canon is not None else None,
            utc_microseconds(start_utc),
            utc_microseconds(end_utc),
        ])
    canonical_parent_rows.sort(key=lambda row: tuple("" if v is None else str(v) for v in row))
    parent_corpus_sha = hashlib.sha256(
        json.dumps(canonical_parent_rows, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    if parent_corpus_sha != EXPECTED_PARENT_SHA:
        fail("UNBOUND_FORENSIC_PARENT_CORPUS_DRIFT", affected_count=EXPECTED_TARGETS)
