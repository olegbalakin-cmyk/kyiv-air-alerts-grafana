    conn = psycopg.connect(
        db_url,
        autocommit=True,
        connect_timeout=20,
        options="-c default_transaction_read_only=on",
    )
    cur = conn.cursor()
    cur.execute("BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY;")
    cur.execute("SET LOCAL default_transaction_read_only = on;")

    def select(sql: str, params=None):
        if not sql.lstrip().upper().startswith("SELECT"):
            fail("NON_READ_ONLY_SQL_ATTEMPT", affected_count=EXPECTED_TARGETS)
        cur.execute(sql, params or ())
        return cur.fetchall()

    ro = select("SELECT current_setting('transaction_read_only'), current_setting('default_transaction_read_only')")
    if not ro or tuple(ro[0]) != ("on", "on"):
