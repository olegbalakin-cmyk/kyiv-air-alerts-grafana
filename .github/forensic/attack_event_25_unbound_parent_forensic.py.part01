    )
    audit_dir = DOWNLOAD_DIR / "audit"
    align_dir = DOWNLOAD_DIR / "alignment"
    download_artifact(EXPECTED_AUDIT_ARTIFACT, audit_dir)
    download_artifact(EXPECTED_ALIGNMENT_ARTIFACT, align_dir)

    audit = load_single_json(audit_dir, "attack_event_23city_parent_binding_audit.json")
    alignment = load_single_json(align_dir, "step2b_parent_binding_contract_alignment.json")

    records = audit.get("records")
    if not isinstance(records, list):
        fail("ACCEPTED_AUDIT_RECORDS_MISSING")
    targets = [r for r in records if isinstance(r, dict) and r.get("binding_state") == "UNBOUND"]
    if len(targets) != EXPECTED_TARGETS:
        fail("UNBOUND_TARGET_COUNT_MISMATCH", affected_count=len(targets))

    invalid_targets = []
    for r in targets:
        reasons = r.get("diagnostic_reason_codes") or []
        if (
            r.get("alert_episode_uid") is not None
            or r.get("exact_parent_candidate_count") != 0
            or "NO_EXACT_PARENT_TUPLE" not in reasons
            or r.get("deterministic_episode_id_validation_result") != "PASS"
        ):
            invalid_targets.append(r.get("classification_key"))
    if invalid_targets:
        fail("ACCEPTED_UNBOUND_INPUT_INVARIANT_MISMATCH", affected_count=len(invalid_targets))

    target_cities = {str(r.get("city_key")) for r in targets}
    if not target_cities.issubset(EXPECTED_CITY_SCOPE):
        fail("UNBOUND_CITY_SCOPE_MISMATCH", affected_count=len(targets))

    parent_from_audit = ((audit.get("parent_corpus") or {}).get("parent_corpus_sha256"))
    if parent_from_audit != EXPECTED_PARENT_SHA:
        fail("ACCEPTED_AUDIT_PARENT_SHA_MISMATCH", affected_count=EXPECTED_TARGETS)

    counts = alignment.get("counts") or {}
    if (
        alignment.get("verdict") != "ATTACK-EVENT 23-CITY PARENT BINDING AUDIT CONTRACT-ALIGNED PASSED"
        or alignment.get("parent_corpus_sha256") != EXPECTED_PARENT_SHA
        or counts.get("BOUND") != EXPECTED_COUNTS["BOUND"]
        or counts.get("UNBOUND") != EXPECTED_COUNTS["UNBOUND"]
        or counts.get("AMBIGUOUS") != EXPECTED_COUNTS["AMBIGUOUS"]
        or counts.get("unbound_records_satisfying_unbound_invariant") != EXPECTED_TARGETS
    ):
        fail("CONTRACT_ALIGNMENT_PROOF_MISMATCH", affected_count=EXPECTED_TARGETS)
    aligned_keys = {
        str(r.get("classification_key"))
        for r in (alignment.get("unbound_classifications") or [])
        if isinstance(r, dict)
    }
    target_keys = {str(r.get("classification_key")) for r in targets}
    if aligned_keys != target_keys:
        fail("CONTRACT_ALIGNMENT_TARGET_SET_MISMATCH", affected_count=EXPECTED_TARGETS)

    # Permanent Neon identity guard before connection.
    db_url = os.environ.get("PHASE1_PROD_SHADOW_DATABASE_URL", "")
