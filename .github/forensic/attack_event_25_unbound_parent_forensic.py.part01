        and c.get("episode_state") == "closed"
        and c.get("canonicalization_version") == CANONICAL_VERSION
        and c.get("start_at") is not None
        and c.get("end_at") is not None
    )


def add_drift_flag(flags: list[str], prefix: str, delta: float | None) -> None:
    if delta is None or delta == 0:
        return
    a = abs(delta)
    if a < 60:
        flags.append(f"{prefix}_DELTA_UNDER_60S")
    elif a <= 300:
        flags.append(f"{prefix}_DELTA_1_TO_5_MIN")
    else:
        flags.append(f"{prefix}_DELTA_OVER_5_MIN")


def stat_triplet(values: list[float]) -> dict | None:
    if not values:
        return None
    values = sorted(values)
    return {
        "min": min(values),
        "median": statistics.median(values),
        "max": max(values),
    }


def compact_example(rec: dict) -> dict:
    return {
        "city_key": rec["city_key"],
        "historical_episode_id": rec["historical_episode_id"],
        "primary_forensic_category": rec["primary_forensic_category"],
        "start_delta_seconds": rec.get("representative_start_delta_seconds"),
        "end_delta_seconds": rec.get("representative_end_delta_seconds"),
        "gap_seconds": rec.get("representative_boundary_gap_seconds"),
        "overlap_seconds": rec.get("representative_overlap_duration_seconds"),
    }


conn = None
cur = None
forensic_records: list[dict] = []
parent_corpus_sha = None
parent_sha_match = "NO"
branch_id = os.environ.get("PHASE1_PROD_SHADOW_BRANCH_ID", "")
db_writes = 0
neon_mutations = 0

try:
    # Accepted artifact identities and exact source material.
