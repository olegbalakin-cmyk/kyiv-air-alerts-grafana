            (city, hs, he),
        )[0][0]
        if int(exact_any) != 0:
            fail("UNBOUND_FORENSIC_INTERNAL_INCONSISTENCY", affected_count=1, detail={"classification_key": ck})

        # Small aggregate probe for category precedence; no row dump.
        agg = select(
            "SELECT "
            "count(*) FILTER (WHERE start_at = %s AND end_at IS DISTINCT FROM %s), "
            "count(*) FILTER (WHERE end_at = %s AND start_at IS DISTINCT FROM %s), "
            "count(*) FILTER (WHERE start_at < %s AND end_at > %s), "
            "count(*) FILTER (WHERE "
            "  (end_at <= %s AND (%s - end_at) <= interval '30 minutes') "
            "  OR (start_at >= %s AND (start_at - %s) <= interval '30 minutes')"
            ") "
            "FROM public.alert_episodes "
            "WHERE city_key = %s AND alert_type = 'AIR' AND episode_state = 'closed' "
            "AND canonicalization_version = %s AND start_at IS NOT NULL AND end_at IS NOT NULL",
            (hs, he, he, hs, he, hs, hs, hs, he, he, city, CANONICAL_VERSION),
        )[0]
        exact_start_count = int(agg[0])
        exact_end_count = int(agg[1])
        overlap_count = int(agg[2])
        nearby_nonoverlap_count = int(agg[3])

        canonical_rows = select(
